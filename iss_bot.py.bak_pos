#!/usr/bin/env python3
# iss_bot.py v4 - Tous les modules integres
import json
import time
import requests
from datetime import datetime, timezone
from pathlib import Path

TG_CONFIG = Path.home() / ".mapci_telegram.json"
ALARM_CONFIG = Path.home() / ".mapci_alarm.json"
STATE_FILE = Path.home() / ".mapci_bot_state.json"


def try_import(name):
    try:
        return __import__(name)
    except Exception:
        return None


bridge = try_import("iss_menu_bridge")
nlp = try_import("iss_nlp")
radio = try_import("iss_radio")
report = try_import("iss_report")
groundtrack = try_import("iss_groundtrack")
kids = try_import("iss_kids")
live = try_import("iss_live")
charts = try_import("iss_charts")
prefs = try_import("iss_prefs")
temporal = try_import("iss_temporal")
radio_live = try_import("iss_radio_live")


def load_tg():
    if TG_CONFIG.exists():
        try:
            return json.loads(TG_CONFIG.read_text())
        except Exception:
            pass
    return None


def load_alarm():
    if ALARM_CONFIG.exists():
        try:
            return json.loads(ALARM_CONFIG.read_text())
        except Exception:
            pass
    return {}


def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            pass
    return {}


def save_state(s):
    STATE_FILE.write_text(json.dumps(s, indent=2))


def api(token, method, data=None, files=None):
    try:
        url = "https://api.telegram.org/bot" + token + "/" + method
        if files:
            r = requests.post(url, data=data, files=files, timeout=20)
        else:
            r = requests.post(url, json=data, timeout=15)
        return r.json()
    except Exception as e:
        return {"ok": False, "error": str(e)}


def send(token, chat_id, text, kb=None):
    d = {"chat_id": chat_id, "text": text, "parse_mode": "Markdown",
         "disable_web_page_preview": True}
    if kb:
        d["reply_markup"] = json.dumps(kb)
    return api(token, "sendMessage", d)


def send_doc(token, chat_id, filepath, caption=""):
    try:
        with open(filepath, "rb") as f:
            return api(token, "sendDocument",
                      data={"chat_id": chat_id, "caption": caption},
                      files={"document": f})
    except Exception:
        return {"ok": False}


def send_photo(token, chat_id, url, caption="", kb=None):
    d = {"chat_id": chat_id, "photo": url, "caption": caption,
         "parse_mode": "Markdown"}
    if kb:
        d["reply_markup"] = json.dumps(kb)
    return api(token, "sendPhoto", d)


def edit(token, chat_id, mid, text, kb=None):
    d = {"chat_id": chat_id, "message_id": mid, "text": text,
         "parse_mode": "Markdown"}
    if kb:
        d["reply_markup"] = json.dumps(kb)
    return api(token, "editMessageText", d)


