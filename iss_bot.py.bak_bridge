def cmd_aujourdhui():
    if iss_temporal is None:
        return "Module indisponible", KB_BACK
    return iss_temporal.texte_periode("jour"), KB_BACK


def cmd_demain():
    if iss_temporal is None:
        return "Module indisponible", KB_BACK
    return iss_temporal.texte_periode("demain"), KB_BACK


def cmd_semaine():
    if iss_temporal is None:
        return "Module indisponible", KB_BACK
    txt = iss_temporal.texte_periode("semaine")
    if iss_charts is not None:
        cfg = load_alarm()
        if cfg.get("lat"):
            try:
                from iss_pass import get_next_passes
                passes = get_next_passes(cfg["lat"], cfg["lon"],
                                        hours=168, min_elevation=0, verbose=False)
                txt += "\n\n" + iss_charts.week_heatmap(passes)
            except Exception:
                pass
    return txt, KB_BACK


def cmd_charts():
    if iss_charts is None:
        return "Module indisponible", KB_BACK
    cfg = load_alarm()
    lat = cfg.get("lat"); lon = cfg.get("lon")
    if lat is None:
        return "Position non configuree", KB_BACK
    try:
        from iss_pass import get_next_passes
        passes = get_next_passes(lat, lon, hours=168, min_elevation=0, verbose=False)
        if not passes:
            return "Aucun passage", KB_BACK
        txt = iss_charts.elevation_chart(passes)
        txt += "\n\n" + iss_charts.duration_chart(passes)
        return txt, KB_BACK
