    iss_prefs.set_pref("notif_avant", val)
    return "✅ Seuil mis a jour : " + str(val) + " minutes", KB_BACK


def cmd_pref_elev():
    if iss_prefs is None:
        return "Module indisponible", KB_BACK
    prefs = iss_prefs.load()
    txt = ("📍 *Elevation minimale*\n\n"
           "Actuel : " + str(prefs.get("elevation_min", 10)) + "°\n\n"
           "Choisis :")
    kb = {"inline_keyboard": [
        [{"text": "0° (tout)", "callback_data": "set_elev_0"},
         {"text": "10°", "callback_data": "set_elev_10"}],
        [{"text": "20°", "callback_data": "set_elev_20"},
         {"text": "30°", "callback_data": "set_elev_30"}],
        [{"text": "Retour", "callback_data": "prefs"}],
    ]}
    return txt, kb


def cmd_set_elev(val):
    if iss_prefs is None:
        return "Module indisponible", KB_BACK
    iss_prefs.set_pref("elevation_min", val)
    return "✅ Elevation mini : " + str(val) + "°", KB_BACK


def cmd_pref_reset():
    if iss_prefs is None:
        return "Module indisponible", KB_BACK
    iss_prefs.reset()
    return "✅ Preferences reinitialisees", KB_BACK


def handle_text(token, chat_id, text):
    cmd = text.strip().lower().split()[0] if text.strip() else ""
    if cmd in ("/start", "/menu", "/help", "/aide"):
        txt, kb = cmd_menu()
    elif cmd == "/status":
        txt, kb = cmd_status()
    elif cmd == "/passes":
        txt, kb = cmd_passes()
    elif cmd == "/iss":
        txt, kb = cmd_iss()
    elif cmd in ("/aujourdhui", "/jour"):
        try:
            from daily_report import build_report
            txt, kb = build_report(), KB_BACK
        except Exception as e:
            txt, kb = "❌ " + str(e), KB_BACK
    elif cmd == "/earth":
        r = cmd_earth()
        if isinstance(r, tuple) and len(r) == 4 and r[0] == "PHOTO":
            _, url, caption, kb = r
            api(token, "sendPhoto", {"chat_id": chat_id, "photo": url,
                "caption": caption, "parse_mode": "Markdown",
                "reply_markup": json.dumps(kb)})
            return
        txt, kb = r
    elif cmd == "/solar":
        txt, kb = cmd_solar()
    elif cmd == "/stats":
        txt, kb = cmd_stats()
    elif cmd == "/quiz":
        txt, kb = cmd_quiz_start()
    elif cmd in ("/aujourdhui", "/today"):
        txt, kb = cmd_aujourdhui()
    elif cmd in ("/demain", "/tomorrow"):
        txt, kb = cmd_demain()
    elif cmd in ("/semaine", "/week"):
        txt, kb = cmd_semaine()
    elif cmd == "/charts":
        txt, kb = cmd_charts()
    elif cmd in ("/prefs", "/preferences", "/config"):
        txt, kb = cmd_prefs()
    else:
        # Analyse NLP
        if iss_nlp is not None:
            intent, _ = iss_nlp.analyser(text)
            if intent == "salut":
                txt, kb = "👋 Salut ! Envoie /menu pour voir les options 🛰️", KB_MAIN
            elif intent == "iss":
                txt, kb = cmd_iss()
            elif intent == "prochain":
                txt, kb = cmd_countdown()
            elif intent == "passes":
                txt, kb = cmd_passes()
            elif intent == "earth":
                r = cmd_earth()
                if isinstance(r, tuple) and len(r) == 4 and r[0] == "PHOTO":
                    _, url, caption, kb = r
                    api(token, "sendPhoto", {"chat_id": chat_id, "photo": url,
                        "caption": caption, "parse_mode": "Markdown",
                        "reply_markup": json.dumps(kb)})
                    return
                txt, kb = r
            elif intent == "quiz":
                txt, kb = cmd_quiz_start()
            elif intent == "stats":
                txt, kb = cmd_stats()
            elif intent == "radio":
                txt, kb = cmd_radio()
            elif intent == "aurores":
                txt, kb = cmd_solar()
            elif intent == "aide":
                txt, kb = cmd_ai_help()
            elif intent == "bravo":
                txt, kb = "😊 Merci ! N'hésite pas à demander autre chose.", KB_MAIN
            else:
                txt, kb = "❓ Je n'ai pas compris. Envoie /menu ou reformule.", KB_MAIN
        else:
            txt, kb = "❓ Commande inconnue. Envoie /menu 👇", KB_MAIN
    send(token, chat_id, txt, keyboard=kb)


def handle_callback(token, chat_id, msg_id, data):
    if data == "menu":
        txt, kb = cmd_menu()
    elif data == "status":
        txt, kb = cmd_status()
    elif data == "passes":
        txt, kb = cmd_passes()
    elif data == "iss":
        txt, kb = cmd_iss()
    elif data == "countdown":
        txt, kb = cmd_countdown()
    elif data == "earth":
        r = cmd_earth()
        if isinstance(r, tuple) and len(r) == 4 and r[0] == "PHOTO":
            _, url, caption, kb = r
            api(token, "sendPhoto", {"chat_id": chat_id, "photo": url,
                "caption": caption, "parse_mode": "Markdown",
                "reply_markup": json.dumps(kb)})
            return
        txt, kb = r
    elif data == "solar":
        txt, kb = cmd_solar()
    elif data == "multisat":
        txt, kb = cmd_multisat()
    elif data.startswith("sat_"):
        txt, kb = cmd_satellite(data[4:])
    elif data == "ical":
        r = cmd_ical()
        if isinstance(r, tuple) and len(r) == 3 and r[0] == "DOC":
            _, filepath, caption = r
            send_document(token, chat_id, filepath, caption)
            return
        txt, kb = r
    elif data == "quiz":
        txt, kb = cmd_quiz_start()
    elif data.startswith("quiz_"):
        try:
            ans = int(data[5:])
            txt, kb = cmd_quiz_answer(ans)
        except Exception:
            txt, kb = "❌", KB_BACK
    elif data == "stats":
        txt, kb = cmd_stats()
    elif data == "radio":
        txt, kb = cmd_radio()
    elif data == "track":
        txt, kb = cmd_track()
    elif data == "report":
        r = cmd_report()
        if isinstance(r, tuple) and len(r) == 3 and r[0] == "DOC":
            _, filepath, caption = r
            send_document(token, chat_id, filepath, caption)
            return
        txt, kb = r
    elif data == "live":
        txt, kb = cmd_live()
    elif data == "kids":
        txt, kb = cmd_kids()
    elif data == "kids_fact":
        txt, kb = cmd_kids_fact()
    elif data == "kids_quiz":
        txt, kb = cmd_quiz_start()
    elif data == "kids_iss":
        txt, kb = cmd_iss()
    elif data == "ai_help":
        txt, kb = cmd_ai_help()
    else:
        txt, kb = "❓ Action inconnue", KB_BACK
    edit(token, chat_id, msg_id, txt, keyboard=kb)


def get_updates(token, offset=None):
    try:
        params = {"timeout": 30}
        if offset:
            params["offset"] = offset
        r = requests.get("https://api.telegram.org/bot" + token + "/getUpdates",
                        params=params, timeout=35)
        return r.json().get("result", [])
    except Exception:
        return []


def main():
    cfg = load_tg()
    if not cfg:
        print("❌ Config Telegram manquante (option 30)")
        return
    token = cfg.get("token")
    my_chat = str(cfg.get("chat_id"))
    if not token or not my_chat:
        print("❌ Token/chat_id manquant")
        return

    print("🤖 MAP-CI Bot V2 demarre (chat ..." + my_chat[-4:] + ")")
    print("   Envoie /menu sur Telegram\n")

    last_id = None
    while True:
        try:
            updates = get_updates(token, offset=last_id)
            for u in updates:
                last_id = u["update_id"] + 1
                if "callback_query" in u:
                    cq = u["callback_query"]
                    cid = str(cq["message"]["chat"]["id"])
                    if cid != my_chat:
                        continue
                    mid = cq["message"]["message_id"]
                    data = cq.get("data", "")
                    print("[" + datetime.now().strftime("%H:%M:%S") + "] Callback : " + data)
                    handle_callback(token, cid, mid, data)
                    api(token, "answerCallbackQuery", {"callback_query_id": cq["id"]})
                elif "message" in u:
                    m = u["message"]
                    cid = str(m["chat"]["id"])
                    if cid != my_chat:
                        continue
                    text = m.get("text", "")
                    if not text:
                        continue
                    print("[" + datetime.now().strftime("%H:%M:%S") + "] Text : " + text[:40])
                    handle_text(token, cid, text)
        except KeyboardInterrupt:
            print("\n👋 Bot arrete.")
            break
        except Exception as e:
            print("⚠️  " + str(e))
            time.sleep(5)


if __name__ == "__main__":
    main()
