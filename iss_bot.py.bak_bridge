def cmd_satellite(sat_key):
    cfg = load_alarm()
    lat = cfg.get("lat"); lon = cfg.get("lon")
    if lat is None:
        return "❌ Position non configuree", KB_BACK
    try:
        from iss_multisat import get_satellite_passes, az_to_cardinal
        passes, info = get_satellite_passes(sat_key, lat, lon, hours=48)
        if not passes:
            return "❌ " + str(info), KB_BACK
        lines = ["🛰️ *" + info + "* — " + str(len(passes)) + " passages\n"]
        for i, p in enumerate(passes[:5], 1):
            rise_c = az_to_cardinal(p["az_rise"]); set_c = az_to_cardinal(p["az_set"])
            lines.append("*" + str(i) + ".* " + p["risetime"].strftime("%d/%m %H:%M") + " UTC\n"
                        "   max " + str(round(p["max_elevation"])) + "deg | "
                        + rise_c + "->" + set_c + " | "
                        + str(round(p["duration_s"])) + "s")
        return "\n".join(lines), KB_BACK
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK


def cmd_ical():
    cfg = load_alarm()
    lat = cfg.get("lat"); lon = cfg.get("lon")
    lieu = cfg.get("lieu", "Position")
    if lat is None:
        return "❌ Position non configuree", KB_BACK
    try:
        from iss_pass import get_next_passes
        from iss_notify import export_ical
        passes = get_next_passes(lat, lon, hours=168, min_elevation=0, verbose=False)
        if not passes:
            return "❌ Aucun passage dans les 7 jours", KB_BACK
        f = export_ical(passes, lieu=lieu)
        return ("DOC", f, "📅 " + str(len(passes)) + " passages (7 jours) - importe dans ton calendrier !"), KB_BACK
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK


def cmd_quiz_start():
    import random
    qs = random.sample(QUIZ_QUESTIONS, 5)
    QUIZ_STATE.write_text(json.dumps({"qs": qs, "idx": 0, "score": 0}))
    return cmd_quiz_question("")


def cmd_quiz_question(feedback):
    state = json.loads(QUIZ_STATE.read_text())
    idx = state["idx"]
    if idx >= len(state["qs"]):
        return cmd_quiz_end(feedback)
    q = state["qs"][idx]
    txt = (feedback + "\n\n" if feedback else "")
    txt += "🎮 *Quiz spatial* (" + str(idx+1) + "/" + str(len(state["qs"])) + ")\n\n❓ " + q["q"]
    kb = {"inline_keyboard": [
        [{"text": "A. " + q["opts"][0], "callback_data": "quiz_0"}],
        [{"text": "B. " + q["opts"][1], "callback_data": "quiz_1"}],
        [{"text": "C. " + q["opts"][2], "callback_data": "quiz_2"}],
    ]}
    return txt, kb


def cmd_quiz_answer(answer_idx):
    state = json.loads(QUIZ_STATE.read_text())
    idx = state["idx"]
    q = state["qs"][idx]
    correct = (answer_idx == q["ans"])
    if correct:
        state["score"] += 1
    state["idx"] += 1
    QUIZ_STATE.write_text(json.dumps(state))
    feedback = "✅ Correct !" if correct else "❌ Rate. Reponse : *" + q["opts"][q["ans"]] + "*"
    return cmd_quiz_question(feedback)


def cmd_quiz_end(feedback):
    state = json.loads(QUIZ_STATE.read_text())
    score = state["score"]; total = len(state["qs"])
    if score == total:
        emoji = "🏆"; msg = "PARFAIT !"
    elif score >= 3:
        emoji = "🎉"; msg = "Bien joue !"
    else:
        emoji = "📚"; msg = "Continue a apprendre !"
    txt = (feedback + "\n\n" if feedback else "")
    txt += emoji + " *Quiz termine*\n\n*Score : " + str(score) + "/" + str(total) + "*\n" + msg
    kb = {"inline_keyboard": [
        [{"text": "🔁 Rejouer", "callback_data": "quiz"}],
        [{"text": "◀️ Menu", "callback_data": "menu"}],
    ]}
    return txt, kb


def cmd_stats():
    try:
        from iss_stats import stats_completes
        s = stats_completes()
        if "message" in s:
            return "📊 " + s["message"], KB_BACK
        txt = ("📊 *Vos statistiques*\n\n"
               "👁️ Observations : *" + str(s["total_observations"]) + "*\n"
               "   ✅ Vus : " + str(s["vus"]) + "\n"
               "   ❌ Rates : " + str(s["rates"]) + "\n"
               "   🎯 Taux : *" + str(s["taux_reussite"]) + "%*\n\n"
               "🌍 Villes : " + str(len(s["villes_observees"])) + "\n")
        for v, n in list(s["villes_observees"].items())[:3]:
            txt += "   • " + v + " : " + str(n) + "\n"
        txt += "\n🚀 Distance cumulee : *" + str(s["distance_cumulee_km"]) + " km*"
        return txt, KB_BACK
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK



