    {"q": "Pays constructeurs ?", "opts": ["3", "5", "15"], "ans": 2},
    {"q": "Masse de l ISS ?", "opts": ["42 t", "420 t", "4200 t"], "ans": 1},
    {"q": "Premier module envoye par ?", "opts": ["USA", "Russie", "Chine"], "ans": 1},
]


def load_tg():
    if not TG_CONFIG.exists():
        return None
    try:
        return json.loads(TG_CONFIG.read_text())
    except Exception:
        return None


def load_alarm():
    if ALARM_CONFIG.exists():
        try:
            return json.loads(ALARM_CONFIG.read_text())
        except Exception:
            pass
    return {}


def api(token, method, data=None, files=None, timeout=15):
    try:
        if files:
            r = requests.post("https://api.telegram.org/bot" + token + "/" + method,
                            data=data, files=files, timeout=timeout)
        else:
            r = requests.post("https://api.telegram.org/bot" + token + "/" + method,
                            json=data, timeout=timeout)
        return r.json()
    except Exception as e:
        return {"ok": False, "error": str(e)}


def send(token, chat_id, text, keyboard=None, markdown=True):
    data = {"chat_id": chat_id, "text": text}
    if markdown:
        data["parse_mode"] = "Markdown"
    data["disable_web_page_preview"] = True
    if keyboard:
        data["reply_markup"] = json.dumps(keyboard)
    return api(token, "sendMessage", data)


def edit(token, chat_id, msg_id, text, keyboard=None, markdown=True):
    data = {"chat_id": chat_id, "message_id": msg_id, "text": text}
    if markdown:
        data["parse_mode"] = "Markdown"
    if keyboard:
        data["reply_markup"] = json.dumps(keyboard)
    return api(token, "editMessageText", data)


def send_document(token, chat_id, filepath, caption=""):
    try:
        with open(filepath, "rb") as f:
            return api(token, "sendDocument",
                      data={"chat_id": chat_id, "caption": caption},
                      files={"document": f}, timeout=30)
    except Exception:
        return {"ok": False}


