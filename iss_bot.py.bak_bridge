KB_BACK = {"inline_keyboard": [[{"text": "◀️ Menu", "callback_data": "menu"}]]}


def cmd_menu():
    return "🛰️ *MAP-CI Tchabio* - Que veux-tu faire ?\n\nUtilise les boutons 👇", KB_MAIN


def cmd_status():
    cfg = load_alarm()
    if not cfg.get("enabled"):
        return "🔕 *Alarme ISS desactivee*\n\nLance option 27 dans MAP-CI.", KB_BACK
    txt = ("🚨 *Alarme ISS active*\n\n"
           "📍 Lieu : " + str(cfg.get("lieu", "?")) + "\n"
           "📡 Coords : `" + str(cfg.get("lat")) + ", " + str(cfg.get("lon")) + "`\n"
           "⏱️ Seuil : " + str(cfg.get("seuil_minutes")) + " min\n"
           "⏳ Duree mini : " + str(cfg.get("duree_min")) + " s")
    return txt, KB_BACK


def cmd_passes():
    cfg = load_alarm()
    lat = cfg.get("lat"); lon = cfg.get("lon")
    if lat is None:
        return "❌ Position non configuree", KB_BACK
    try:
        from iss_pass import get_next_passes
        passes = get_next_passes(lat, lon, hours=48, min_elevation=0, verbose=False)
        if not passes:
            return "❌ Aucun passage dans les 48h", KB_BACK
        lines = ["🛰️ *" + str(len(passes)) + " prochains passages ISS*\n"]
        now = datetime.now(timezone.utc)
        for i, p in enumerate(passes[:8], 1):
            rt = p["risetime"]
            delta = (rt - now).total_seconds() / 60
            h = int(delta // 60); m = int(delta % 60)
            quand = "dans " + str(h) + "h" + str(m).zfill(2) if h else "dans " + str(m) + " min"
            emoji = "🟢" if p["max_elevation"] > 60 else "🟡" if p["max_elevation"] > 20 else "⚪"
            lines.append(emoji + " *" + str(i) + ".* " + rt.strftime("%d/%m %H:%M") + " UTC — _" + quand + "_\n"
                        "   max " + str(round(p["max_elevation"])) + "deg | "
                        + str(p.get("cardinal_rise", "?")) + "->" + str(p.get("cardinal_set", "?")) + " | "
                        + str(round(p["duration_s"])) + "s")
        return "\n".join(lines), KB_BACK
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK


def cmd_iss():
    try:
        d = requests.get("http://api.open-notify.org/iss-now.json", timeout=10).json()
        p = d["iss_position"]
        ts = datetime.fromtimestamp(d["timestamp"], tz=timezone.utc)
        lat, lon = p["latitude"], p["longitude"]
        txt = ("🛰️ *Position ISS*\n\n"
               "📡 Lat : `" + lat + "deg`\n"
               "📡 Lon : `" + lon + "deg`\n"
               "🚀 Alt : ~408 km\n"
               "⚡ Vitesse : ~27600 km/h\n"
               "⏰ " + ts.strftime("%H:%M:%S") + " UTC\n\n"
               "[📍 Voir sur OSM](https://www.openstreetmap.org/?mlat=" + lat + "&mlon=" + lon + "#map=3/" + lat + "/" + lon + ")")
        kb = {"inline_keyboard": [
            [{"text": "🗺️ Carte OSM", "url": "https://www.openstreetmap.org/?mlat=" + lat + "&mlon=" + lon + "#map=3/" + lat + "/" + lon}],
            [{"text": "◀️ Menu", "callback_data": "menu"}],
        ]}
        return txt, kb
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK


def cmd_countdown():
    cfg = load_alarm()
    lat = cfg.get("lat"); lon = cfg.get("lon")
    if lat is None:
        return "❌ Position non configuree", KB_BACK
    try:
        from iss_pass import get_next_passes
        passes = get_next_passes(lat, lon, hours=24, min_elevation=0, verbose=False)
        if not passes:
            return "Aucun passage dans les 24h", KB_BACK
        p = passes[0]
        rt = p["risetime"]
        now = datetime.now(timezone.utc)
        delta = max(0, (rt - now).total_seconds())
        h = int(delta // 3600); m = int((delta % 3600) // 60); s = int(delta % 60)
        emoji = "🟢" if p["max_elevation"] > 60 else "🟡" if p["max_elevation"] > 20 else "⚪"
        txt = ("⏱️ *Prochain passage ISS*\n\n"
               "🕐 *" + str(h).zfill(2) + ":" + str(m).zfill(2) + ":" + str(s).zfill(2) + "*\n\n"
               + emoji + " Max " + str(round(p["max_elevation"])) + "deg\n"
               "🧭 " + str(p.get("cardinal_rise", "?")) + " -> " + str(p.get("cardinal_set", "?")) + "\n"
               "⏳ Duree " + str(round(p["duration_s"])) + "s\n"
               "📍 " + str(cfg.get("lieu", "?")) + "\n\n"
               "🕒 Risetime : " + rt.strftime("%d/%m %H:%M:%S") + " UTC")
        return txt, KB_BACK
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK


def cmd_earth():
    try:
        r = requests.get("https://epic.gsfc.nasa.gov/api/natural", timeout=10).json()
        if not r:
            return "❌ Pas de donnees EPIC", KB_BACK
        latest = r[-1]
        date = latest["date"].split()[0].replace("-", "/")
        img_name = latest["image"]
        img_url = "https://epic.gsfc.nasa.gov/archive/natural/" + date + "/png/" + img_name + ".png"
        caption = latest.get("caption", "")
        txt = ("🌍 *La Terre vue de l espace*\n\n"
               "📸 Satellite : DSCOVR (NASA)\n"
               "📅 " + latest["date"] + "\n"
               "📍 Distance : ~1.5 million km\n\n"
               "_" + caption + "_")
        kb = {"inline_keyboard": [
            [{"text": "🔗 Voir en HD", "url": img_url}],
            [{"text": "🔄 Actualiser", "callback_data": "earth"}],
            [{"text": "◀️ Menu", "callback_data": "menu"}],
        ]}
        return ("PHOTO", img_url, txt, kb)
    except Exception as e:
        return "❌ Erreur : " + str(e), KB_BACK


def cmd_solar():
    try:
        r = requests.get("https://services.swpc.noaa.gov/json/planetary_k_index_1m.json", timeout=10).json()
        kp = float(r[-1]["kp_index"]) if r else 0
    except Exception:
        kp = None
    level = "Calme" if kp is None or kp < 3 else "Actif" if kp < 5 else "Orage G1" if kp < 6 else "Orage G2+" if kp < 7 else "Orage G3+"
    emoji = "🟢" if (kp or 0) < 3 else "🟡" if (kp or 0) < 5 else "🔴"
    try:
        flares = requests.get("https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json", timeout=10).json()
        last_flare = flares[-1] if flares else None
    except Exception:
        last_flare = None
    txt = "☀️ *Meteo spatiale*\n\n"
    txt += emoji + " *Kp index* : " + str(kp) + "\n"
    txt += "📊 Niveau : " + level + "\n\n"
    if (kp or 0) >= 5:
        txt += "🌟 *Aurores boreales possibles !*\n\n"
    if last_flare:
        txt += ("⚡ Derniere eruption :\n"
                "   Classe : *" + str(last_flare.get("max_class", "?")) + "*\n"
                "   Debut : " + str(last_flare.get("begin_time", "?"))[:16] + "\n")
    txt += "\n[📊 Donnees NOAA](https://www.swpc.noaa.gov/)"
    return txt, KB_BACK


