def cmd_timelapse_generate(n):
    try:
        import iss_timelapse
    except Exception as e:
        return "❌ " + str(e), KB_BACK
    try:
        session = iss_timelapse.capture_sequence(n=n, interval=2)
        video, err = iss_timelapse.assembler_video(session, fps=6)
        if err or not video:
            return "❌ " + (err or "echec"), KB_BACK
        return ("VIDEO", video, "🎬 Timelapse ISS (" + str(n) + " frames)")
    except Exception as e:
        return "❌ " + str(e), KB_BACK


def cmd_ai_chat_help():
    try:
        import iss_ai
        key_ok = iss_ai.has_key()
    except Exception:
        key_ok = False
    if not key_ok:
        return ("🤖 *IA conversationnelle*\n\n"
                "❌ *Clé API Groq manquante*\n\n"
                "Envoie :\n"
                "`/ask ta question`\n\n"
                "Mais configure d'abord la clé sur ton PC/Termux avec set_key.py"), KB_BACK
    return ("🤖 *IA conversationnelle active !*\n\n"
            "Pose n'importe quelle question :\n\n"
            "*Exemples :*\n"
            "• /ask Comment fonctionne une fusée ?\n"
            "• /ask Quelle est la différence entre ISS et Tiangong ?\n"
            "• /ask Combien de satellites en orbite ?\n\n"
            "_Ou envoie directement ta question (plus de 15 caractères)_"), KB_BACK


def cmd_ai_question(question):
    try:
        import iss_ai
    except Exception as e:
        return "❌ Module IA : " + str(e), KB_BACK
    try:
        rep, err = iss_ai.demander(question)
    except Exception as e:
        return "❌ " + str(e), KB_BACK
    if err:
        return "❌ " + str(err), KB_BACK
    if not rep:
        return "❌ Pas de réponse", KB_BACK
    return "🤖 *MAP-CI*\n\n" + rep, KB_BACK


